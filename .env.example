# ==============================================================================
# IncidentGraph AI — Environment Configuration Template
# ==============================================================================

# 1. IncidentGraph AI Local Storage (SQLite - zero admin permissions required)
DATABASE_URL="file:./dev.db"

# 2. Hosted Observability (Grafana Cloud / Cloud OTLP)
# Use Grafana Cloud (Free Tier) to run real OpenTelemetry without Docker or admin rights.
# Refer to docs/GRAFANA_CLOUD_SETUP.md for instructions on retrieving these values.
#
# OTLP Gateway Endpoint (Region: ap-south-1)
GRAFANA_CLOUD_OTLP_ENDPOINT="https://otlp-gateway-prod-ap-south-1.grafana.net/otlp"
# Grafana Cloud Instance ID / User ID (numeric, e.g. 1871065)
GRAFANA_CLOUD_INSTANCE_ID="1871065"

# A. Least-Privilege Ingestion Token:
# Requires scopes: 'metrics:write', 'traces:write' (add 'logs:write' if exporting logs)
# Create in Grafana Cloud Portal -> Security -> Access Policies -> Add Policy
GRAFANA_CLOUD_INGESTION_TOKEN=""

# B. Least-Privilege Telemetry Querying (Prometheus Metrics Read):
# Retrieve from Grafana Cloud Portal -> Prometheus card -> Details
# Format: https://prometheus-prod-XX-prod-ap-south-1.grafana.net/api/prom
GRAFANA_CLOUD_PROMETHEUS_URL=""
GRAFANA_CLOUD_PROMETHEUS_USER="1871065"
# Metrics read token: Requires scope 'metrics:read'
GRAFANA_CLOUD_PROMETHEUS_TOKEN=""

# C. Prometheus Remote-Write (Metrics Push from Local Prometheus to Grafana Cloud):
# Retrieve from Grafana Cloud Portal -> Prometheus card -> Details -> Remote Write Endpoint
# Format: https://prometheus-prod-XX-prod-ap-south-1.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_REMOTE_WRITE_URL=""
GRAFANA_CLOUD_PROMETHEUS_REMOTE_WRITE_USER="1871065"
# Dedicated metrics write token: Requires scope 'metrics:write'
GRAFANA_CLOUD_PROMETHEUS_REMOTE_WRITE_TOKEN=""

# D. Least-Privilege Telemetry Querying (Tempo Traces):
# Retrieve from Grafana Cloud Portal -> Tempo card -> Details
# Format: https://tempo-prod-XX-prod-ap-south-1.grafana.net
GRAFANA_CLOUD_TEMPO_USER="1871065"
GRAFANA_CLOUD_TEMPO_URL=""
# Traces read token: Requires scope 'traces:read'
GRAFANA_CLOUD_TEMPO_TOKEN=""

# Service and Environment Metadata
ENVIRONMENT="production-hosted"
DEPLOYMENT_ENVIRONMENT="production-hosted"

# 3. Local Observability Fallback (Used when Grafana Cloud is not configured)
PROMETHEUS_URL="http://localhost:9090"
JAEGER_URL="http://localhost:16686"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# 4. Sample Microservices Ports
SAMPLE_GATEWAY_PORT=4000
SAMPLE_ORDER_PORT=4001
SAMPLE_PAYMENT_PORT=4002
SAMPLE_INVENTORY_PORT=4003

# 5. Sample Microservices Storage Configuration
# If a remote hosted PostgreSQL (Neon, Supabase, AWS RDS) is available, set SAMPLE_DATABASE_URL.
# If omitted or offline, the microservices will automatically use the built-in zero-admin
# local storage implementation (sample-services/data/sample_store.json) without admin rights.
# SAMPLE_DATABASE_URL="postgresql://user:password@remote-db.cloud.provider:5432/sample_ecommerce?sslmode=require"

# 6. SRE Detection & Query Timeouts
TELEMETRY_QUERY_TIMEOUT_MS=4000
TELEMETRY_LOOKBACK_MINUTES=15
INCIDENT_DETECTION_COOLDOWN_SECONDS=60

# 7. AI Incident Investigator Configuration
# Provider: "openai" | "mock" (leave empty to auto-detect from OPENAI_API_KEY)
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-placeholder-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
# Custom endpoint for proxies / Azure / vLLM (optional)
# OPENAI_BASE_URL="https://api.openai.com/v1"
AI_REQUEST_TIMEOUT_MS=20000
